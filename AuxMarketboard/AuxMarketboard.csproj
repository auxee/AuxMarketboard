<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <AssemblyName>AuxMarketboard</AssemblyName>
    <RootNamespace>AuxMarketboard</RootNamespace>
    <Version>0.2.1.0</Version>
    <Description>Price shopping lists from Universalis and plan which worlds to buy from.</Description>
    <Authors>Auxie</Authors>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="AuxUi\Fonts\*" Link="Fonts\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
